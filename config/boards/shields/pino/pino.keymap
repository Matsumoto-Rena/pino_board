#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* D2の1キーだけ物理配線されているので、一時的にbt BT_CLRを割り当ててボンドクリア用に使う */
            bindings = <
                &bt BT_CLR    &kp B    &kp C
                &kp D         &kp E    &kp F
            >;
        };
    };
};