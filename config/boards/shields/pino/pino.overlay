/* pino.overlay - D0, D1 削除版 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>; /* 6から4に減らしました */
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
            /* 問題児の &gpio0 2 (D0) と &gpio0 3 (D1) を削除しました */
            = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // D2
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // D3
            , <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // D4
            , <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // D5
            ;
    };
};
